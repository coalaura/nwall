# Empty / missing User-Agent
ua_empty;

##
# SEO Crawlers / Backlink Scrapers
##
ua_contains "semrushbot";
ua_contains "ahrefsbot";
ua_contains "mj12bot";
ua_contains "dotbot";
ua_contains "blexbot";
ua_contains "linkfluence";
ua_contains "seokicks";
ua_contains "seopowersuite";
ua_contains "serpstatbot";
ua_contains "webmeup-crawler";
ua_contains "backlinkcrawler";
ua_contains "seranking";
ua_contains "sistrix";
ua_contains "lipperhey";

##
# AI Scrapers
##
ua_contains "gptbot";
ua_contains "chatgpt-user";
ua_contains "oai-searchbot";
ua_contains "anthropic-ai";
ua_contains "claude-web";
ua_contains "claudebot";
ua_contains "ccbot";
ua_contains "cohere-ai";
ua_contains "bytespider";
ua_contains "amazonbot";
ua_contains "omgili";
ua_contains "diffbot";
ua_contains "applebot-extended";
ua_contains "meta-externalagent";
ua_contains "facebookexternalhit";
ua_contains "perplexitybot";
ua_contains "google-extended";
ua_contains "imagesiftbot";
ua_contains "mistral-ai";
ua_contains "youbot";

##
# Aggressive / Unwanted Crawlers
##
ua_contains "barkrowler";
ua_contains "seznambot";
ua_contains "yandexbot";
ua_contains "petalbot";
ua_contains "petal bot";
ua_contains "megaindex";
ua_contains "bingpreview";
ua_contains "censysinspect";
ua_contains "neevabot";
ua_contains "mauibot";
ua_contains "domainsproject";
ua_contains "ioncrawl";

##
# Vulnerability Scanners / Malicious
##
ua_contains "nmap";
ua_contains "nikto";
ua_contains "sqlmap";
ua_contains "masscan";
ua_contains "zmeu";
ua_contains "morfeus";
ua_contains "openvas";
ua_contains "nessus";
ua_contains "w3af";
ua_contains "havij";
ua_contains "acunetix";
ua_contains "burpcollaborator";
ua_contains "dirbuster";
ua_contains "gobuster";
ua_contains "wfuzz";
ua_contains "nuclei";
ua_contains "jaeles";

##
# Path probes
##

# VCS metadata (/.git/HEAD, /project/.git/config, /.svn/entries)
path_contains "/.git/";
path_suffix "/.git";
path_contains "/.svn/";
path_suffix "/.svn";
path_contains "/.hg/";
path_suffix "/.hg";
path_contains "/.bzr/";
path_suffix "/.bzr";

# Env files: /.env, /.env.local, /api/.env, /secret.env
path_contains "/.env";
path_suffix ".env";

# App / server secrets
path_suffix "/.htpasswd";
path_suffix "/.htaccess";
path_suffix "/.npmrc";
path_suffix "/.yarnrc";
path_suffix "/.pypirc";
path_suffix "/.netrc";
path_suffix "/.bash_history";
path_suffix "/.mysql_history";
path_suffix "/.git-credentials";
path_suffix "/.gitconfig";
path_suffix "/rclone.conf";
path_suffix "/.boto";
path_suffix "/.s3cfg";
path_suffix "/wp-config.php";
path_suffix "/wp-config.php.bak";
path_suffix "/localsettings.php";
path_suffix "/settings.php.bak";

# SSH / TLS private material
path_contains "/.ssh/";
path_suffix "/.ssh";
path_suffix "/id_rsa";
path_suffix "/id_dsa";
path_suffix "/id_ecdsa";
path_suffix "/id_ed25519";
path_suffix "/authorized_keys";
path_suffix "/known_hosts";
path_suffix "/server.key";
path_suffix "/private.key";
path_suffix "/privatekey.key";
path_suffix "/privkey.pem";

# Cloud / CI credential dumps
path_contains "/.aws/";
path_contains "/.docker/";
path_contains "/.kube/";
path_contains "/.azure/";
path_contains "/.github/";
path_contains "/.vscode/";
path_suffix "/credentials.json";
path_suffix "/secrets.json";
path_suffix "/secrets.yml";
path_suffix "/secrets.yaml";
path_suffix "/serviceaccountkey.json";
path_suffix "/service-account.json";
path_suffix "/service_account.json";
path_suffix "/firebase-adminsdk.json";
path_suffix "/firebase-service-account.json";
path_suffix "/key.json";

# IaC / state (often has secrets)
path_suffix ".tfstate";
path_suffix ".tfvars";
path_contains "/.terraform/";

# Scanner junk that is never a real app route
path_suffix "/wp-admin.php";
path_suffix "/phpinfo.php";
path_suffix "/info.php";
path_suffix "/.ds_store";
path_suffix "/thumbs.db";